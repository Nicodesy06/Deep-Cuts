{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cradex",
  "version": "0.3.2",
  "identifier": "app.cradex.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cradex",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' dcaudio: http://dcaudio.localhost blob:; connect-src 'self' ipc: http://ipc.localhost dcaudio: http://dcaudio.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "resources": {
      "../models/panns_mobilenetv1.onnx": "models/panns_mobilenetv1.onnx",
      "../models/README.md": "models/README.md"
    },
    "shortDescription": "Local, private DJ library intelligence",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
